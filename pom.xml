<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nurulislam</groupId>
    <artifactId>SIAP-NurulIslam</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SIAP - Sistem Informasi Absensi Pelajar MA Nurul Islam</name>
    <description>
        Aplikasi Absensi Siswa Berbasis Desktop pada MA Nurul Islam menggunakan Java (JavaFX) dan MySQL.
        Tugas Akhir - Muhammad Rafik - D3 Teknik Informatika, Politeknik Hasnur.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javafx.version>21.0.2</javafx.version>
        <mysql.version>8.3.0</mysql.version>
        <zxing.version>3.5.3</zxing.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <javacv.version>1.5.13</javacv.version>
        <opencv.version>4.13.0-1.5.13</opencv.version>

        <!-- Kelas utama yang dijalankan (lihat class Launcher) -->
        <mainClass>com.nurulislam.siap.app.Launcher</mainClass>
    </properties>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <!-- Dipakai SwingFXUtils untuk mengonversi frame BufferedImage (webcam-capture) ke javafx.scene.image.Image -->
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Driver MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!-- ZXing: generate & baca QR Code (untuk kartu pelajar & scan absensi) -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- OpenPDF: ekspor laporan ke file PDF berbentuk tabel -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.30</version>
        </dependency>

        <!-- BCrypt: hashing password login -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!-- Kamera untuk halaman Scan QR: dipakai via OpenCV (JavaCV), BUKAN webcam-capture
             (Sarxos), karena webcam-capture terbukti sering menghasilkan frame gambar
             rusak/warna solid (mis. oranye polos) di banyak kamera Windows modern yang
             hanya mendukung format MJPEG/YUY2. OpenCV, lewat backend DirectShow di kode
             ScanQrController, jauh lebih andal untuk kasus ini.
             Catatan: hanya native Windows (windows-x86_64) yang diambil - bukan
             "opencv-platform" (yang mengunduh native SEMUA OS/arsitektur, ratusan MB
             lebih besar dari yang dibutuhkan). -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv</artifactId>
            <version>${javacv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>${opencv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>${opencv.version}</version>
            <classifier>windows-x86_64</classifier>
        </dependency>

        <!-- OpenCV bergantung ke OpenBLAS (library aljabar linier) sebagai backend
             komputasinya. Tanpa dependency EKSPLISIT ini, Maven hanya menarik openblas
             versi "kosong" (tanpa file native .dll) secara transitif lewat opencv,
             sehingga OpenCVFrameConverter gagal dimuat dengan error:
             "UnsatisfiedLinkError: no jniopenblas_nolapack in java.library.path".
             Versi 0.3.31-1.5.13 dipastikan cocok dengan javacpp 1.5.13 di bawah. -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>0.3.31-1.5.13</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>0.3.31-1.5.13</version>
            <classifier>windows-x86_64</classifier>
        </dependency>

        <!-- Dipaksa eksplisit supaya versinya SAMA PERSIS dengan opencv di atas
             (4.13.0-1.5.13 -> javacpp 1.5.13). Tanpa ini, Maven bisa menarik
             javacpp versi lebih lama secara transitif (mis. 1.5.11) yang membuat
             native library OpenCV gagal dimuat saat aplikasi berjalan. -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>1.5.13</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>SIAP-NurulIslam</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Plugin untuk menjalankan aplikasi JavaFX langsung: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Gunakan Launcher agar runtime terminal konsisten dengan entry point aplikasi. -->
                    <mainClass>com.nurulislam.siap.app.Launcher</mainClass>

                    <!--
                        JavaCV/OpenCV/JavaCPP adalah dependency non-modular.
                        Paksa semua dependency runtime ke classpath agar Maven JavaFX
                        tidak memindahkan/mengecualikan native JAR saat membentuk module-path.
                    -->
                    <runtimePathOption>CLASSPATH</runtimePathOption>
                    <includePathExceptionsInClasspath>true</includePathExceptionsInClasspath>

                    <!-- Paksa JavaCPP memilih binary native Windows x64 yang benar. -->
                    <options>
                        <option>-Djavacpp.platform=windows-x86_64</option>
                    </options>
                </configuration>
            </plugin>

            <!-- Bundle semua dependency jadi satu jar (agar mudah dijalankan / didemokan) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>