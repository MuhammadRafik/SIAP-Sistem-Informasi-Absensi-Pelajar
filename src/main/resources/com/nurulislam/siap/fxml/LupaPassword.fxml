<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="600.0" prefWidth="960.0" styleClass="login-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nurulislam.siap.controller.LupaPasswordController">

    <!-- Panel kiri: branding, konsisten dengan halaman Login -->
    <VBox alignment="CENTER" prefWidth="380" spacing="12" styleClass="login-brand-panel">
        <padding>
            <Insets top="40" right="30" bottom="40" left="30"/>
        </padding>
        <Label text="SIAP" styleClass="brand-logo"/>
        <Label text="Sistem Informasi Absensi Pelajar" styleClass="brand-subtitle" wrapText="true"
               textAlignment="CENTER"/>
        <Label text="MA Nurul Islam" styleClass="brand-subtitle"/>
    </VBox>

    <!-- Panel kanan: form lupa password -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-form-panel">
        <VBox alignment="CENTER" maxWidth="360" spacing="16">
            <Label text="Lupa Password" styleClass="form-title"/>
            <Label text="Masukkan email akun Anda. Kode reset akan ditampilkan di layar ini."
                   styleClass="form-caption" wrapText="true" textAlignment="CENTER"/>

            <VBox spacing="6">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="contoh@sekolah.id" styleClass="text-field-rounded"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

            <Button fx:id="btnKirim" text="Kirim Kode Reset" styleClass="btn-primary" maxWidth="Infinity" defaultButton="true"/>

            <Hyperlink fx:id="linkKembali" text="Kembali ke Login" styleClass="link"/>
        </VBox>
    </StackPane>
</HBox>
