<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nurulislam.siap.controller.PengaturanAkunController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <Label text="Pengaturan Akun" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label text="Kelola informasi akun dan ubah password." wrapText="true"/>

    <VBox spacing="8.0">
        <Label text="Nama"/>
        <TextField fx:id="fieldNama"/>

        <Label text="Email"/>
        <TextField fx:id="fieldEmail"/>

        <Label text="Role"/>
        <Label fx:id="labelRole" text="-"/>
    </VBox>

    <Label text="Ubah Password" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="8.0">
        <Label text="Password Lama"/>
        <PasswordField fx:id="fieldPasswordLama" promptText="Masukkan password lama"/>

        <Label text="Password Baru"/>
        <PasswordField fx:id="fieldPasswordBaru" promptText="Minimal 6 karakter"/>

        <Label text="Konfirmasi Password Baru"/>
        <PasswordField fx:id="fieldKonfirmasi" promptText="Ulangi password baru"/>
    </VBox>

    <Label fx:id="labelError" wrapText="true"/>

    <HBox spacing="10.0">
        <Button fx:id="btnKembali" text="Kembali"/>
        <Button fx:id="btnSimpanPassword" text="Simpan Password"/>
    </HBox>
</VBox>
