<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nurulislam.siap.controller.VerifikasiAkunController">

    <!-- ================= Sidebar kiri (sama seperti Dashboard) ================= -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" spacing="4">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets bottom="20" top="4"/>
                </padding>
                <StackPane styleClass="brand-icon">
                    <Label text="S" styleClass="brand-icon-text"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="SIAP" styleClass="sidebar-brand"/>
                    <Label text="Sistem Informasi Absensi Pelajar" styleClass="sidebar-brand-sub" wrapText="true"/>
                </VBox>
            </HBox>

            <Button fx:id="btnNavDashboard" text="Dashboard" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavVerifikasi" text="Verifikasi Akun" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <Button fx:id="btnNavScanQr" text="Scan QR" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavDataMurid" text="Data Murid" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavDataKelas" text="Data Kelas" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavMataPelajaran" text="Mata Pelajaran" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavCetakKartu" text="Cetak Kartu Pelajar" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavLaporan" text="Laporan" styleClass="nav-item" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="system-status-box" spacing="4">
                <Label text="System Status: Active" styleClass="system-status-text"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= Konten utama ================= -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <VBox styleClass="dashboard-body" spacing="20">
                <padding>
                    <Insets top="24" right="32" bottom="32" left="32"/>
                </padding>

                <!-- Top bar -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="2">
                        <Label text="Verifikasi Akun" styleClass="topbar-title"/>
                        <Label text="Setujui, tolak, dan kelola status akun Staf TU dan Guru Mata Pelajaran"
                               styleClass="greeting-caption"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="labelNamaUser" text="Admin User" styleClass="user-name"/>
                        <Label fx:id="labelRoleUser" text="School Administrator" styleClass="user-role"/>
                    </VBox>
                    <StackPane fx:id="avatarBox" styleClass="avatar-circle">
                        <Label fx:id="labelInisialUser" text="A" styleClass="avatar-text"/>
                    </StackPane>
                </HBox>

                <!-- Tab status: Menunggu Verifikasi / Terverifikasi / Nonaktif -->
                <HBox spacing="8" styleClass="filter-tab-group">
                    <ToggleButton fx:id="tabStatusMenunggu" text="Menunggu Verifikasi" styleClass="filter-tab, filter-tab-active"/>
                    <ToggleButton fx:id="tabStatusTerverifikasi" text="Terverifikasi" styleClass="filter-tab"/>
                    <ToggleButton fx:id="tabStatusNonaktif" text="Nonaktif" styleClass="filter-tab"/>
                </HBox>

                <!-- Filter peran -->
                <HBox spacing="8" styleClass="filter-tab-group">
                    <ToggleButton fx:id="tabSemua" text="Semua" styleClass="filter-tab, filter-tab-active"/>
                    <ToggleButton fx:id="tabGuru" text="Guru Mata Pelajaran" styleClass="filter-tab"/>
                    <ToggleButton fx:id="tabTU" text="Staf TU" styleClass="filter-tab"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="labelJumlah" text="0 akun menunggu" styleClass="card-subtitle"/>
                </HBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

                <!-- Tabel akun -->
                <VBox styleClass="card" spacing="14" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tabelAkun" styleClass="tabel-akun" VBox.vgrow="ALWAYS" prefHeight="380">
                        <columns>
                            <TableColumn fx:id="kolomNama" text="Nama" prefWidth="220"/>
                            <TableColumn fx:id="kolomEmail" text="Email" prefWidth="240"/>
                            <TableColumn fx:id="kolomRole" text="Peran" prefWidth="170"/>
                            <TableColumn fx:id="kolomTanggalDaftar" text="Tanggal Daftar" prefWidth="160"/>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button fx:id="btnRefresh" text="Muat Ulang" styleClass="btn-secondary"/>
                        <!-- Aksi tab "Menunggu Verifikasi" -->
                        <Button fx:id="btnTolak" text="Tolak" styleClass="btn-danger"/>
                        <Button fx:id="btnVerifikasi" text="Verifikasi" styleClass="btn-primary"/>
                        <!-- Aksi tab "Terverifikasi" -->
                        <Button fx:id="btnNonaktifkan" text="Nonaktifkan" styleClass="btn-danger" visible="false" managed="false"/>
                        <!-- Aksi tab "Nonaktif" -->
                        <Button fx:id="btnAktifkanKembali" text="Aktifkan Kembali" styleClass="btn-primary" visible="false" managed="false"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
