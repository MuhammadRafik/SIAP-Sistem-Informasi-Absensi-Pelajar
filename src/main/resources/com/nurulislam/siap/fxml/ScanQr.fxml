<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nurulislam.siap.controller.ScanQrController">

    <!-- ================= Sidebar kiri ================= -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" spacing="4">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets bottom="20" top="4"/>
                </padding>
<ImageView image="@../images/logo-siap.png" fitWidth="32" fitHeight="46" preserveRatio="true" smooth="true"/>
                <VBox spacing="1">
                    <Label text="SIAP" styleClass="sidebar-brand"/>
                    <Label fx:id="labelSidebarSub" text="Sistem Informasi Absensi Pelajar" styleClass="sidebar-brand-sub" wrapText="true"/>
                </VBox>
            </HBox>

            <Button fx:id="btnNavDashboard" text="Dashboard" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavVerifikasi" text="Verifikasi Akun" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavScanQr" text="Scan QR" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <Button fx:id="btnNavDataMurid" text="Data Murid" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavDataKelas" text="Data Kelas" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavMataPelajaran" text="Mata Pelajaran" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavCetakKartu" text="Cetak Kartu Pelajar" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavLaporan" text="Laporan" styleClass="nav-item" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="system-status-box" spacing="4">
                <Label fx:id="labelStatusKamera" text="Kamera: Mencari..." styleClass="system-status-text"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= Konten utama ================= -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <VBox styleClass="dashboard-body" spacing="20">
                <padding>
                    <Insets top="24" right="32" bottom="32" left="32"/>
                </padding>

                <!-- Top bar -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Scan QR" styleClass="topbar-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox styleClass="date-chip" alignment="CENTER_LEFT">
                        <Label fx:id="labelTanggal" text="Senin, 24 Mei 2024" styleClass="date-chip-text"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="labelNamaUser" text="Memuat…" styleClass="user-name"/>
                        <Label fx:id="labelRoleUser" text="" styleClass="user-role"/>
                    </VBox>
                    <StackPane fx:id="avatarBox" styleClass="avatar-circle">
                        <ImageView fx:id="imgAvatar" fitWidth="40" fitHeight="40" preserveRatio="false"/>
                        <Label fx:id="labelInisialUser" text="?" styleClass="avatar-text"/>
                    </StackPane>
                </HBox>

                <!-- Rekap hari ini -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Hadir" styleClass="stat-label"/>
                        <Label fx:id="labelRekapHadir" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Terlambat" styleClass="stat-label"/>
                        <Label fx:id="labelRekapTerlambat" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-teal" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Izin/Sakit" styleClass="stat-label"/>
                        <Label fx:id="labelRekapIzinSakit" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-red" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="QR Tak Dikenal" styleClass="stat-label"/>
                        <Label fx:id="labelRekapGagal" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <!-- Kamera + Hasil/Riwayat -->
                <HBox spacing="20">

                    <!-- Kiri: preview kamera -->
                    <VBox HBox.hgrow="ALWAYS" spacing="16" alignment="TOP_CENTER">
                        <StackPane styleClass="scanqr-camera-frame" maxWidth="560" prefWidth="560" prefHeight="560">
                            <ImageView fx:id="imageViewKamera" fitWidth="560" fitHeight="560" preserveRatio="false"/>
                            <Label fx:id="labelKameraOverlay" text="Menyiapkan kamera..." styleClass="scanqr-camera-overlay-text"/>
                            <VBox styleClass="scanqr-viewfinder" maxWidth="280" maxHeight="280" prefWidth="280" prefHeight="280"/>
                            <VBox alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT">
                                <padding>
                                    <Insets top="16" left="16"/>
                                </padding>
                                <HBox styleClass="scanqr-status-chip" alignment="CENTER_LEFT" spacing="6">
                                    <StackPane fx:id="dotStatusKamera" styleClass="scanqr-status-dot"/>
                                    <Label fx:id="labelChipKamera" text="KAMERA AKTIF" styleClass="scanqr-status-chip-text"/>
                                </HBox>
                            </VBox>
                        </StackPane>

                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Arahkan QR Code siswa ke kamera" styleClass="scanqr-instruction-title"/>
                            <Label text="Pastikan kode berada di dalam kotak dan pencahayaan mencukupi untuk proses pemindaian otomatis."
                                   styleClass="scanqr-instruction-caption" wrapText="true" maxWidth="480" textAlignment="CENTER"/>
                        </VBox>

                        <!-- Fallback input manual, untuk kondisi kamera tidak tersedia / uji coba -->
                        <HBox spacing="8" alignment="CENTER" maxWidth="480">
                            <TextField fx:id="fieldInputManual" promptText="Atau ketik NIS / kode QR secara manual" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnInputManual" text="Absen" styleClass="btn-primary"/>
                        </HBox>
                    </VBox>

                    <!-- Kanan: hasil terakhir + riwayat -->
                    <VBox prefWidth="360" minWidth="340" spacing="16">

                        <VBox styleClass="card, scanqr-result-card" spacing="14">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Hasil Pemindaian Terakhir" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="labelWaktuScanTerakhir" text="--:--:--" styleClass="scanqr-time-chip"/>
                            </HBox>
                            <Separator/>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <StackPane styleClass="scanqr-avatar-lg">
                                    <Label fx:id="labelInisialHasil" text="?" styleClass="scanqr-avatar-lg-text"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="labelNamaHasil" text="Belum ada pemindaian" styleClass="scanqr-result-nama"/>
                                    <Label fx:id="labelNisHasil" text="" styleClass="log-kelas"/>
                                    <Label fx:id="labelKelasHasil" text="" styleClass="log-kelas"/>
                                </VBox>
                            </HBox>
                            <Separator/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="WAKTU ABSEN" styleClass="scanqr-mini-label"/>
                                    <Label fx:id="labelJamHasil" text="--:--" styleClass="scanqr-jam-hasil"/>
                                </VBox>
                                <Label fx:id="labelBadgeHasil" text="MENUNGGU" styleClass="status-badge, status-badge-izin"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                            <Label text="Riwayat Scan Hari Ini" styleClass="card-title"/>
                            <Separator/>
                            <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
                                <VBox fx:id="riwayatScanBox" spacing="8"/>
                            </ScrollPane>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
