<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nurulislam.siap.controller.AbsensiMapelController">

    <!-- ================= Sidebar kiri ================= -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" spacing="4">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets bottom="20" top="4"/>
                </padding>
                <StackPane styleClass="brand-icon">
                    <Label text="S" styleClass="brand-icon-text"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="SIAP" styleClass="sidebar-brand"/>
                    <Label fx:id="labelSidebarSub" text="Sistem Informasi Absensi Pelajar" styleClass="sidebar-brand-sub" wrapText="true"/>
                </VBox>
            </HBox>

            <Button fx:id="btnNavBeranda" text="Beranda" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavJadwal" text="Jadwal Mengajar" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavAbsensiMapel" text="Absensi Mata Pelajaran" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <Button fx:id="btnNavLaporan" text="Laporan" styleClass="nav-item" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="system-status-box" spacing="4">
                <Label fx:id="labelStatusKamera" text="Kamera: Mencari..." styleClass="system-status-text"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= Konten utama ================= -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <VBox styleClass="dashboard-body" spacing="20">
                <padding>
                    <Insets top="24" right="32" bottom="32" left="32"/>
                </padding>

                <!-- Top bar -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Absensi Mata Pelajaran" styleClass="topbar-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox styleClass="date-chip" alignment="CENTER_LEFT">
                        <Label fx:id="labelTanggal" text="Senin, 24 Mei 2024" styleClass="date-chip-text"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="labelNamaUser" text="Memuat…" styleClass="user-name"/>
                        <Label fx:id="labelRoleUser" text="" styleClass="user-role"/>
                    </VBox>
                    <StackPane fx:id="avatarBox" styleClass="avatar-circle">
                        <ImageView fx:id="imgAvatar" fitWidth="40" fitHeight="40" preserveRatio="false"/>
                        <Label fx:id="labelInisialUser" text="?" styleClass="avatar-text"/>
                    </StackPane>
                </HBox>

                <!-- Pilih jadwal (jika lebih dari satu sesi hari ini) -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Pilih Sesi Mengajar:" styleClass="field-label"/>
                    <ComboBox fx:id="comboJadwal" styleClass="combo-rounded" prefWidth="380"/>
                    <Button fx:id="btnRefreshJadwal" text="Refresh Jadwal" styleClass="btn-secondary"/>
                </HBox>

                <!-- Kartu info sesi aktif -->
                <HBox styleClass="card" spacing="0" alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <Label text="MATA PELAJARAN" styleClass="scanqr-mini-label"/>
                        <Label fx:id="labelInfoMapel" text="-" styleClass="card-title"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <padding>
                            <Insets left="20"/>
                        </padding>
                        <Label text="JAM / WAKTU" styleClass="scanqr-mini-label"/>
                        <Label fx:id="labelInfoJam" text="-" styleClass="card-title"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <padding>
                            <Insets left="20"/>
                        </padding>
                        <Label text="KELAS / GURU" styleClass="scanqr-mini-label"/>
                        <Label fx:id="labelInfoKelasGuru" text="-" styleClass="card-title"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4">
                        <padding>
                            <Insets left="20"/>
                        </padding>
                        <Label fx:id="labelInfoStatus" text="BELUM ADA JADWAL" styleClass="status-badge, status-badge-izin"/>
                    </VBox>
                </HBox>

                <!-- Rekap sesi ini -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Hadir" styleClass="stat-label"/>
                        <Label fx:id="labelRekapHadir" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-teal" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Izin/Sakit" styleClass="stat-label"/>
                        <Label fx:id="labelRekapIzinSakit" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Terlambat" styleClass="stat-label"/>
                        <Label fx:id="labelRekapTerlambat" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-red" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Tidak Masuk/Alfa" styleClass="stat-label"/>
                        <Label fx:id="labelRekapAlfa" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-gray" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Belum Absen" styleClass="stat-label"/>
                        <Label fx:id="labelRekapBelumAbsen" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <!-- Kamera + Absen Masuk -->
                <HBox spacing="20">

                    <!-- Kiri: preview kamera -->
                    <VBox HBox.hgrow="ALWAYS" spacing="16" alignment="TOP_CENTER">
                        <StackPane styleClass="scanqr-camera-frame" maxWidth="520" prefWidth="520" prefHeight="520">
                            <ImageView fx:id="imageViewKamera" fitWidth="520" fitHeight="520" preserveRatio="false"/>
                            <Label fx:id="labelKameraOverlay" text="Menyiapkan kamera..." styleClass="scanqr-camera-overlay-text"/>
                            <VBox styleClass="scanqr-viewfinder" maxWidth="260" maxHeight="260" prefWidth="260" prefHeight="260"/>
                            <VBox alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT">
                                <padding>
                                    <Insets top="16" left="16"/>
                                </padding>
                                <HBox styleClass="scanqr-status-chip" alignment="CENTER_LEFT" spacing="6">
                                    <StackPane fx:id="dotStatusKamera" styleClass="scanqr-status-dot"/>
                                    <Label fx:id="labelChipKamera" text="KAMERA AKTIF" styleClass="scanqr-status-chip-text"/>
                                </HBox>
                            </VBox>
                        </StackPane>

                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Arahkan QR Code siswa ke kamera" styleClass="scanqr-instruction-title"/>
                            <Label text="Absensi hanya berlaku untuk siswa pada kelas sesi ini." wrapText="true"
                                   styleClass="scanqr-instruction-caption" maxWidth="440" textAlignment="CENTER"/>
                        </VBox>

                        <!-- Fallback input manual -->
                        <HBox spacing="8" alignment="CENTER" maxWidth="440">
                            <TextField fx:id="fieldInputManual" promptText="Atau ketik NIS / kode QR secara manual" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnInputManual" text="Absen" styleClass="btn-primary"/>
                        </HBox>
                    </VBox>

                    <!-- Kanan: rekap terakhir + daftar absen masuk -->
                    <VBox prefWidth="400" minWidth="360" spacing="16">

                        <VBox styleClass="card, scanqr-result-card" spacing="14">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Hasil Pemindaian Terakhir" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="labelWaktuScanTerakhir" text="--:--:--" styleClass="scanqr-time-chip"/>
                            </HBox>
                            <Separator/>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <StackPane styleClass="scanqr-avatar-lg">
                                    <Label fx:id="labelInisialHasil" text="?" styleClass="scanqr-avatar-lg-text"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="labelNamaHasil" text="Belum ada pemindaian" styleClass="scanqr-result-nama"/>
                                    <Label fx:id="labelNisHasil" text="" styleClass="log-kelas"/>
                                </VBox>
                            </HBox>
                            <Separator/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="WAKTU ABSEN" styleClass="scanqr-mini-label"/>
                                    <Label fx:id="labelJamHasil" text="--:--" styleClass="scanqr-jam-hasil"/>
                                </VBox>
                                <Label fx:id="labelBadgeHasil" text="MENUNGGU" styleClass="status-badge, status-badge-izin"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                            <Label text="Absen Masuk" styleClass="card-title"/>
                            <Separator/>
                            <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
                                <VBox fx:id="absenMasukBox" spacing="8"/>
                            </ScrollPane>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>