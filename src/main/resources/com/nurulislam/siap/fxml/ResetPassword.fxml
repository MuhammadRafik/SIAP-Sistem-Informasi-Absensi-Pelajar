<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="600.0" prefWidth="960.0" styleClass="login-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nurulislam.siap.controller.ResetPasswordController">

    <!-- Panel kiri: branding, konsisten dengan halaman Login -->
    <VBox alignment="CENTER" prefWidth="380" spacing="12" styleClass="login-brand-panel">
        <padding>
            <Insets top="40" right="30" bottom="40" left="30"/>
        </padding>
        <Label text="SIAP" styleClass="brand-logo"/>
        <Label text="Sistem Informasi Absensi Pelajar" styleClass="brand-subtitle" wrapText="true"
               textAlignment="CENTER"/>
        <Label text="MA Nurul Islam" styleClass="brand-subtitle"/>
    </VBox>

    <!-- Panel kanan: form reset password -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-form-panel">
        <ScrollPane fitToWidth="true" styleClass="form-scroll">
            <StackPane alignment="CENTER">
            <VBox alignment="CENTER" maxWidth="360" spacing="14">
                <padding>
                    <Insets top="30" bottom="30"/>
                </padding>

                <Label text="Reset Password" styleClass="form-title"/>
                <Label text="Masukkan kode reset yang ditampilkan sebelumnya, lalu buat kata sandi baru."
                       styleClass="form-caption" wrapText="true" textAlignment="CENTER"/>

                <VBox spacing="6">
                    <Label text="Email" styleClass="field-label"/>
                    <Label fx:id="emailLabel" styleClass="field-value"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Kode Reset" styleClass="field-label"/>
                    <TextField fx:id="tokenField" promptText="Masukkan 6 digit kode" styleClass="text-field-rounded"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Kata Sandi Baru" styleClass="field-label"/>
                    <StackPane>
                        <PasswordField fx:id="passwordField" promptText="Minimal 6 karakter" styleClass="text-field-rounded"/>
                        <TextField fx:id="passwordVisibleField" promptText="Minimal 6 karakter" styleClass="text-field-rounded"/>
                    </StackPane>
                </VBox>

                <VBox spacing="6">
                    <Label text="Konfirmasi Kata Sandi Baru" styleClass="field-label"/>
                    <StackPane>
                        <PasswordField fx:id="konfirmasiPasswordField" promptText="Ulangi kata sandi baru" styleClass="text-field-rounded"/>
                        <TextField fx:id="konfirmasiPasswordVisibleField" promptText="Ulangi kata sandi baru" styleClass="text-field-rounded"/>
                    </StackPane>
                </VBox>

                <CheckBox fx:id="showPasswordCheckBox" text="Tampilkan kata sandi" styleClass="show-password-check"/>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

                <Button fx:id="btnReset" text="Ganti Kata Sandi" styleClass="btn-primary" maxWidth="Infinity" defaultButton="true"/>

                <HBox alignment="CENTER" spacing="4">
                    <Hyperlink fx:id="linkMintaKodeBaru" text="Minta kode baru" styleClass="link"/>
                    <Label text="•" styleClass="form-caption"/>
                    <Hyperlink fx:id="linkKembaliLogin" text="Kembali ke Login" styleClass="link"/>
                </HBox>
            </VBox>
            </StackPane>
        </ScrollPane>
    </StackPane>
</HBox>
