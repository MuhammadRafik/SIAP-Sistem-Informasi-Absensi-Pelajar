<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nurulislam.siap.controller.DataKelasDetailController"
            styleClass="dashboard-root">

    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" spacing="4">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets bottom="20" top="4"/>
                </padding>
                <StackPane styleClass="brand-icon">
                    <Label text="S" styleClass="brand-icon-text"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="SIAP" styleClass="sidebar-brand"/>
                    <Label text="Sistem Informasi Absensi Pelajar" styleClass="sidebar-brand-sub" wrapText="true"/>
                </VBox>
            </HBox>

            <Button fx:id="btnNavDashboard" text="Dashboard" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavVerifikasi" text="Verifikasi Akun" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavScanQr" text="Scan QR" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavDataMurid" text="Data Murid" styleClass="nav-item" maxWidth="Infinity"/>

            <Button fx:id="btnNavDataKelas" text="Data Kelas   ⌄"
                    styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>

            <VBox fx:id="boxSubKelas" spacing="2" managed="true" visible="true"
                  style="-fx-padding: 0 0 0 14;">
                <Button fx:id="btnKelasXIPS" text="X IPS" alignment="CENTER_LEFT"
                        styleClass="nav-item" style="-fx-padding: 7 10 7 16; -fx-font-size: 13px; -fx-background-color: transparent;" maxWidth="Infinity"/>
                <Button fx:id="btnKelasXIPA" text="X IPA" alignment="CENTER_LEFT"
                        styleClass="nav-item" style="-fx-padding: 7 10 7 16; -fx-font-size: 13px; -fx-background-color: transparent;" maxWidth="Infinity"/>
                <Button fx:id="btnKelasXIIPS" text="XI IPS" alignment="CENTER_LEFT"
                        styleClass="nav-item" style="-fx-padding: 7 10 7 16; -fx-font-size: 13px; -fx-background-color: transparent;" maxWidth="Infinity"/>
                <Button fx:id="btnKelasXIIPA" text="XI IPA" alignment="CENTER_LEFT"
                        styleClass="nav-item" style="-fx-padding: 7 10 7 16; -fx-font-size: 13px; -fx-background-color: transparent;" maxWidth="Infinity"/>
                <Button fx:id="btnKelasXIIIPS" text="XII IPS" alignment="CENTER_LEFT"
                        styleClass="nav-item" style="-fx-padding: 7 10 7 16; -fx-font-size: 13px; -fx-background-color: transparent;" maxWidth="Infinity"/>
                <Button fx:id="btnKelasXIIIPA" text="XII IPA" alignment="CENTER_LEFT"
                        styleClass="nav-item" style="-fx-padding: 7 10 7 16; -fx-font-size: 13px; -fx-background-color: transparent;" maxWidth="Infinity"/>
            </VBox>

            <Button fx:id="btnNavMataPelajaran" text="Mata Pelajaran" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavCetakKartu" text="Cetak Kartu Pelajar" styleClass="nav-item" maxWidth="Infinity"/>
            <Button fx:id="btnNavLaporan" text="Laporan" styleClass="nav-item" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="system-status-box" spacing="4">
                <Label text="Sistem Aktif" styleClass="system-status-text"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <VBox styleClass="dashboard-body" spacing="18">
                <padding>
                    <Insets top="24" right="28" bottom="32" left="32"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="3">
                        <Label text="Data Murid per Kelas" styleClass="topbar-title"/>
                        <Label fx:id="labelNamaKelas" text="-" styleClass="greeting-caption"/>
                        <Label fx:id="labelTingkatJurusan" text="-" styleClass="greeting-caption"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="1">
                        <Label fx:id="labelNamaUser" text="Memuat…" styleClass="user-name"/>
                        <Label fx:id="labelRoleUser" text="" styleClass="user-role"/>
                    </VBox>
                    <StackPane fx:id="avatarBox" styleClass="avatar-circle">
                        <ImageView fx:id="imgAvatar" fitWidth="40" fitHeight="40" preserveRatio="false"/>
                        <Label fx:id="labelInisialUser" text="A" styleClass="avatar-text"/>
                    </StackPane>
                    <Button fx:id="btnKembali" text="← Kembali ke Data Kelas" styleClass="btn-secondary"/>
                </HBox>

                <HBox spacing="14">
                    <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="TOTAL MURID" styleClass="stat-label"/>
                        <Label fx:id="labelTotalMurid" text="0" styleClass="stat-value"/>
                    </VBox>

                    <VBox styleClass="stat-card, stat-card-teal" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="WALI KELAS" styleClass="stat-label"/>
                        <Label fx:id="labelWaliKelas" text="-" styleClass="stat-value" wrapText="true"/>
                    </VBox>

                    <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="LAKI-LAKI" styleClass="stat-label"/>
                        <Label fx:id="labelLakiLaki" text="0" styleClass="stat-value"/>
                    </VBox>

                    <VBox styleClass="stat-card, stat-card-red" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="PEREMPUAN" styleClass="stat-label"/>
                        <Label fx:id="labelPerempuan" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <Label fx:id="labelStatus" text="" styleClass="error-label" wrapText="true"/>

                <VBox styleClass="card" spacing="14" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="fieldPencarian"
                                   promptText="Cari NIS atau nama murid di kelas ini..."
                                   styleClass="text-field-rounded"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRefresh" text="Muat Ulang" styleClass="btn-secondary"/>
                        <Button fx:id="btnTambahMurid" text="+ Tambah Murid" styleClass="btn-primary"/>
                        <Button fx:id="btnUbahMurid" text="Edit Murid" styleClass="btn-secondary"/>
                    </HBox>

                    <TableView fx:id="tabelMurid" styleClass="tabel-akun"
                               prefHeight="500" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="kolomNis" text="NIS" prefWidth="130"/>
                            <TableColumn fx:id="kolomNama" text="Nama Lengkap" prefWidth="260"/>
                            <TableColumn fx:id="kolomJenisKelamin" text="Jenis Kelamin" prefWidth="150"/>
                            <TableColumn fx:id="kolomTanggalLahir" text="Tanggal Lahir" prefWidth="150"/>
                            <TableColumn fx:id="kolomStatus" text="Status" prefWidth="120"/>
                            <TableColumn fx:id="kolomAksi" text="Aksi" prefWidth="190"/>
                        </columns>
                    </TableView>

                    <Label text="Klik Ubah untuk mengedit data murid. Gunakan Aktifkan/Nonaktifkan untuk mengatur status siswa. Tombol Tambah Murid otomatis memilih kelas ini."
                           styleClass="tip-text" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
